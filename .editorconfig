root = true

[*]
charset = utf-8
end_of_line = crlf
indent_size = 3
indent_style = space
insert_final_newline = false
max_line_length = 120
tab_width = 3

[*.nbtt]
indent_style = tab
max_line_length = 150

[{*.har,*.json,*.jsonc,*.png.mcmeta,mcmod.info,pack.mcmeta}]
indent_size = 2

[{*.yaml,*.yml}]
indent_size = 2
